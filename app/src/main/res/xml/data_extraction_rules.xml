<?xml version="1.0" encoding="utf-8"?>
<!--
data_extraction_rules.xml configura copias y transferencia de datos en Android reciente.
El manifiesto lo referencia mediante dataExtractionRules.
cloud-backup se relaciona con copia en la nube; device-transfer con traslado entre dispositivos.
En esta plantilla no hay filtros include o exclude activos personalizados.
La disponibilidad efectiva de copias depende de Android y de la configuración del dispositivo.
-->
<!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>
