<?xml version="1.0" encoding="utf-8"?>
<!--
ic_launcher_round.xml define el recurso de icono indicado para lanzadores con forma redonda.
Comparte los dibujos de fondo, primer plano y versión monocromática del icono principal.
El manifiesto lo selecciona mediante android:roundIcon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
